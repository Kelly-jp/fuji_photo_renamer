{
  "name": "fuji-photo-renamer",
  "version": "1.0.5",
  "description": "富士フイルムの写真ファイルリネームツール",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "build-all": "electron-builder --mac --win",
    "create-zip": "node create-zip.js"
  },
  "build": {
    "appId": "com.fujiphotorenamer.app",
    "productName": "FUJI Photo Renamer",
    "copyright": "Copyright © 2026 Kelly-jp. All rights reserved.",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "node_modules/exiftool-vendored.pl/bin/",
          "to": "bin"
        }
      ],
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "extraResources": [
        {
          "from": "node_modules/exiftool-vendored.exe/bin/",
          "to": "bin"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "exiftool-vendored": "^34.3.0",
    "fast-xml-parser": "^5.3.3",
    "fs-extra": "^11.3.3"
  }
}
